# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Generated by `tauri android init` / `tauri ios init`
# regenerated by CI on each mobile build, not committed
/gen/android
/gen/apple

# Build outputs and signing material — safety net in case any of these ever land outside
# gen/android or target/ (e.g. a local test build/signing pass run from a different cwd).
# Never commit a real signing key.
*.apk
*.aab
*.ipa
*.jks
*.keystore
keystore.properties
